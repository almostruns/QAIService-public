# 应用数据库名
QAI_DB_NAME=qaiservice
# 应用数据库用户
QAI_DB_USER=qaiservice
# 应用数据库密码
QAI_DB_PASSWORD=
# 数据库 root 密码
QAI_DB_ROOT_PASSWORD=
# Web 服务端口
QAI_HTTP_PORT=8080
# 容器日志和业务日期使用的时区
TZ=Asia/Shanghai
# HTTPS 部署时设为 true
QAI_COOKIE_SECURE=false
# 是否允许注册新用户
QAI_REGISTRATION_ENABLED=true
# 上传文件保存目录
QAI_FILE_STORAGE_ROOT=/var/lib/qaiservice/files
# 服务日志文件
QAI_LOG_PATH=/var/log/qaiservice/qaiservice.log
# 聊天提供方：mock 或 openai-compatible
QAI_CHAT_PROVIDER=mock
# 大模型 API 地址
QAI_MODEL_BASE_URL=
# 大模型名称
QAI_MODEL_NAME=
# 大模型 API Key
QAI_MODEL_API_KEY=
# 大模型请求超时（毫秒）
QAI_MODEL_TIMEOUT_MS=30000

# 联网搜索总开关
QAI_WEB_SEARCH_ENABLED=false
# 搜索提供方，当前为 baidu
QAI_WEB_SEARCH_PROVIDER=baidu
# 百度千帆搜索 API Key
QAI_BAIDU_SEARCH_API_KEY=
# 搜索连接超时（毫秒）
QAI_WEB_SEARCH_CONNECT_TIMEOUT_MS=1000
# 搜索请求超时（毫秒）
QAI_WEB_SEARCH_TIMEOUT_MS=5000
# 搜索候选结果数
QAI_WEB_SEARCH_TOP_K=10

# 是否启用语义重排
QAI_RERANK_ENABLED=false
# 重排服务地址
QAI_RERANK_URL=http://retrieval:8090/rerank
# 重排请求超时（毫秒）
QAI_RERANK_TIMEOUT_MS=5000
# 是否启用 Token 计数服务
QAI_TOKEN_ENABLED=false
# Token 服务地址
QAI_TOKEN_BASE_URL=http://retrieval:8090
# Token 请求超时（毫秒）
QAI_TOKEN_TIMEOUT_MS=5000
# 重排模型
QAI_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 检索服务端口
QAI_RERANK_PORT=8090

# RabbitMQ 用户
QAI_RABBITMQ_USER=qaiservice
# RabbitMQ 密码
QAI_RABBITMQ_PASSWORD=
# RabbitMQ 虚拟主机
QAI_RABBITMQ_VHOST=/
# 聊天消息队列名
QAI_RABBITMQ_QUEUE=qaiservice.chat-messages
# RabbitMQ 管理页面端口
QAI_RABBITMQ_MANAGEMENT_PORT=15672
